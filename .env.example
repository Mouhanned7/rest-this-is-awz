# DAILY CHICKEN — copier les valeurs nécessaires dans .env (ne jamais publier ce fichier).
# Le fichier .env existant est conservé : complétez-le sans effacer vos clés.

# Aperçu local uniquement : inutile de renseigner DAILY_PORT et HOST sur Vercel.
DAILY_PORT=3000
HOST=127.0.0.1
# En production : URL HTTPS du projet Vercel, sans slash final.
PUBLIC_BASE_URL=http://127.0.0.1:3000
ONLINE_ORDERING_ENABLED=false

# Stripe > Développeurs > Clés API. Commencer avec sk_test_.
STRIPE_SECRET_KEY=
# Stripe > Webhooks > secret de signature de /api/stripe/webhook (whsec_...).
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired.
STRIPE_WEBHOOK_SECRET=
# Pas de clé pk_ nécessaire : le site redirige vers Stripe Checkout hébergé.

# Firebase > Paramètres du projet > Comptes de service > SDK Admin > Générer une clé privée.
# Copier les trois champs du JSON. La clé privée reste UNIQUEMENT sur le serveur.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# Exemple de format de clé : "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative : chemin absolu du JSON privé ; ne pas renseigner les deux méthodes.
# GOOGLE_APPLICATION_CREDENTIALS=C:/chemin/prive/service-account.json

# Compte responsable Flutter. Firebase Authentication > activer Email/Mot de passe.
# Utilisé uniquement par npm run admin:setup, jamais envoyé à l'application.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Mot de passe initial d'au moins 6 caractères (ou davantage selon la politique Firebase), à changer dans Firebase si nécessaire.

# Configuration PUBLIQUE Firebase de l'application mobile (aucun secret Stripe ici).
# Firebase > Paramètres du projet > Vos applications. Enregistrer Android et iOS.
FIREBASE_API_KEY=
# Si Android possède une clé publique distincte, copier current_key de google-services.json.
FIREBASE_ANDROID_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=fr.dailychicken.dailyOrders
# Facultatif, pour tester également le tableau de bord dans un navigateur.
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=

# Google Maps : AUCUNE clé nécessaire pour détecter la position et ouvrir l'itinéraire.
# Facultatif : clé serveur Google Geocoding. Sans cette clé, recherche IGN/BAN en France métropolitaine.
GOOGLE_MAPS_SERVER_API_KEY=

# E-mails SMTP : adresse Gmail et mot de passe d'application (pas le mot de passe habituel).
# Activer la validation en deux étapes puis https://myaccount.google.com/apppasswords
# E-mail au client après confirmation payée OU annulation non payée.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# Gmail par défaut. Pour un autre fournisseur, adapter le serveur et utiliser 465 ou 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Adresse de réponse facultative ; l'expéditeur est SMTP_EMAIL.
ORDER_EMAIL_REPLY_TO=

# Vercel uniquement, facultatif : protection du point de reprise planifiée.
# Secret aléatoire de 32 caractères minimum, uniquement dans les variables Vercel.
# Sans Cron, le responsable peut reprendre une action depuis l'application.
CRON_SECRET=

# Développement seulement : émulateurs Firebase (ne pas définir en production).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional recipient for contact-page proposals; defaults to SMTP_EMAIL.
CONTACT_EMAIL=

# Optional, only while archived/pending test orders still need cancellation or transfer.
# Never used to create a new public payment. Remove after test orders are cleared.
STRIPE_LEGACY_TEST_SECRET_KEY=
