rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDailyAdmin() {
      return request.auth != null && request.auth.token.dailyAdmin == true;
    }
    match /dailyOrders/{orderId} {
      allow read: if isDailyAdmin();
      allow write: if false;
    }
    // Secrets, event ledger and any legacy collections remain server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
